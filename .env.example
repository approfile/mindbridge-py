# ---------------------------------------------------------------------------
# MindBridge configuration template.
# Copy to `.env` and fill in the values you need. `.env` is git-ignored.
# Every value below is optional: with an empty file the app boots with
# AI_PROVIDER=mock and SQLite, which is enough to run the tests and the harness.
# ---------------------------------------------------------------------------

# --- Agent runtime ---
# Only `event_driven_multi_agent` is implemented. Unknown values are reported as
# a fallback in GET /api/agent/status and the event-driven runtime is used anyway.
AGENT_FRAMEWORK=event_driven_multi_agent
# Turn budget for the claim-based scheduler.
AGENT_MAX_ROUNDS=8
AGENT_MAX_CLAIMS_PER_ROUND=4
AGENT_MAX_CLAIMS_PER_AGENT=3
AGENT_FINAL_ACCEPTANCE_MIN_CONFIDENCE=0.6

# --- Model provider: ollama | openai | mock ---
AI_PROVIDER=mock

# Local fine-tuned GGUF model served by Ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mindbridge-qwen2.5-7b-ft:latest
FINETUNED_MODEL_NAME=mindbridge-qwen2.5-7b-ft:latest
FINETUNED_MODEL_DIR=models/mindbridge-qwen2.5-7b-ft
FINETUNED_MODEL_FILE=mindbridge-qwen2.5-7b-ft-q4_k_m.gguf

# Any OpenAI-compatible chat endpoint (official API, DeepSeek, DashScope, ...).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.35
AI_MAX_TOKENS=512

# --- Persistence ---
# Default target is MySQL; SQLite also works and needs no server:
#   DATABASE_URL=sqlite:///./data/mindbridge.db
DATABASE_URL=mysql+pymysql://mindbridge:mindbridge@127.0.0.1:3306/mindbridge?charset=utf8mb4
# Leave Redis unreachable and short-term memory degrades to "no history" instead
# of failing the request.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MEMORY_TTL_SECONDS=86400
REDIS_MEMORY_MAX_MESSAGES=40
REDIS_SOCKET_TIMEOUT_SECONDS=2
MEMORY_COMPACTION_ENABLED=true
MEMORY_COMPACTION_RECENT_MESSAGES=8
MEMORY_SUMMARY_MAX_CHARS=500

# --- Retrieval ---
KNOWLEDGE_TOP_K=4
KNOWLEDGE_CANDIDATE_K=16
KNOWLEDGE_CHUNK_SIZE=512
KNOWLEDGE_CHUNK_OVERLAP=64
KNOWLEDGE_HYBRID_VECTOR_WEIGHT=0.65
KNOWLEDGE_HYBRID_BM25_WEIGHT=0.35
KNOWLEDGE_RERANK_ENABLED=true
# Set KNOWLEDGE_VECTOR_REQUIRED=true to fail fast instead of degrading to BM25.
KNOWLEDGE_VECTOR_ENABLED=true
KNOWLEDGE_VECTOR_REQUIRED=false
# Embeddings may use their own endpoint and key.
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=30
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=mindbridge_knowledge
CHROMA_SNAPSHOT_DIR=data/chroma-snapshots
CHROMA_SNAPSHOT_KEEP=5

# --- Tool queue and post-processing ---
TOOL_QUEUE_ENABLED=true
TOOL_QUEUE_POLL_INTERVAL_SECONDS=1
TOOL_QUEUE_BATCH_SIZE=10
TOOL_QUEUE_MAX_ATTEMPTS=3
TOOL_QUEUE_RETRY_DELAY_SECONDS=15
TOOL_QUEUE_EXCEL_WORKERS=1
TOOL_QUEUE_EMAIL_WORKERS=2
EXCEL_PATH=data/mindbridge-risk-ledger.xlsx

# --- Alert delivery: log | smtp ---
# `log` records the alert without sending mail, which is the demo default.
ALERT_EMAIL_DELIVERY_MODE=log
ALERT_EMAIL_RATE_LIMIT_PER_MINUTE=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_SUBJECT_PREFIX=[MindBridge 高风险预警]

# --- Server ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
