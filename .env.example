AGENT_FRAMEWORK=event_driven_multi_agent
AI_PROVIDER=mock
INTENT_JSON_MODE=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mindbridge-qwen2.5-7b-ft:latest
FINETUNED_MODEL_NAME=mindbridge-qwen2.5-7b-ft:latest
FINETUNED_MODEL_DIR=models/mindbridge-qwen2.5-7b-ft
FINETUNED_MODEL_FILE=mindbridge-qwen2.5-7b-ft-q4_k_m.gguf
# Last real evaluation used these compatible API/model settings (2026-10-28).
# Keep AI_PROVIDER=mock above for an offline demo; use openai for real APIs.
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash
OPENAI_THINKING_MODE=auto
# Real usage ledger: unknown usage/prices remain null. Reverify the dated price catalog before expiry.
MODEL_PRICING_FILE=app/pricing/model-prices-v1.json
MODEL_STREAM_INCLUDE_USAGE=true
OPENAI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=qwen3.7-text-embedding
DATABASE_URL=mysql+pymysql://mindbridge:mindbridge@127.0.0.1:3306/mindbridge?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MEMORY_TTL_SECONDS=86400
REDIS_MEMORY_MAX_MESSAGES=40
REDIS_SOCKET_TIMEOUT_SECONDS=2
MEMORY_COMPACTION_ENABLED=true
MEMORY_COMPACTION_RECENT_MESSAGES=8
MEMORY_SUMMARY_MAX_CHARS=500
REPLY_MAX_REVISIONS=1
REPLY_TIMEOUT_SECONDS=45
REPLY_MAX_CHARS=8000
REPLY_REVIEW_JSON_MODE=true
REPLY_REVIEW_MAX_TOKENS=1024
# Transport retries share the existing reply/turn deadline; no safety/JSON retries.
MODEL_TRANSPORT_MAX_ATTEMPTS=2
MODEL_RETRY_BASE_DELAY_SECONDS=0.25
MODEL_RETRY_MIN_REMAINING_SECONDS=0.5
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
KNOWLEDGE_TOP_K=4
KNOWLEDGE_QUERY_MAX_CHARS=1024
KNOWLEDGE_CANDIDATE_K=16
KNOWLEDGE_HYBRID_VECTOR_WEIGHT=0.65
KNOWLEDGE_HYBRID_BM25_WEIGHT=0.35
KNOWLEDGE_RERANK_ENABLED=true
KNOWLEDGE_VECTOR_ENABLED=true
KNOWLEDGE_VECTOR_REQUIRED=false
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=mindbridge_knowledge
CHROMA_SNAPSHOT_DIR=data/chroma-snapshots
CHROMA_SNAPSHOT_KEEP=5
EMBEDDING_TIMEOUT_SECONDS=30
RAG_EVAL_ENABLED=false
RAG_EVAL_EXIT_AFTER_RUN=false
RAG_EVAL_DATASET=app/rag_eval/data/retrieval-v1.json
RAG_EVAL_OUTPUT=target/rag-eval-report.json
TOOL_QUEUE_ENABLED=true
TOOL_QUEUE_POLL_INTERVAL_SECONDS=1
TOOL_QUEUE_BATCH_SIZE=10
TOOL_QUEUE_MAX_ATTEMPTS=3
TOOL_QUEUE_RETRY_DELAY_SECONDS=15
TOOL_QUEUE_LEASE_SECONDS=120
MCP_TOOL_TIMEOUT_SECONDS=45
TOOL_QUEUE_EXCEL_WORKERS=1
TOOL_QUEUE_EMAIL_WORKERS=2
ALERT_EMAIL_RATE_LIMIT_PER_MINUTE=30
ALERT_EMAIL_DELIVERY_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_SUBJECT_PREFIX=[MindBridge 高风险预警]

# Structured business logs always go to stderr; optional single-process JSONL rotation.
# OBSERVABILITY_LOG_FILE=data/logs/application.jsonl
OBSERVABILITY_LOG_MAX_BYTES=10485760
OBSERVABILITY_LOG_BACKUPS=3

# AGENT_FINAL_ACCEPTANCE_MIN_CONFIDENCE is retired: explicit legacy values
# are ignored with a warning. Plan acceptance uses plan-contract-v1 checks.

# One monotonic HTTP turn budget, per-process admission and bounded blocking I/O.
TURN_TIMEOUT_SECONDS=60
TURN_MAX_INFLIGHT=4
TURN_MAX_INFLIGHT_PER_USER=2
TURN_IO_TIMEOUT_SECONDS=15
TURN_CLEANUP_WAIT_SECONDS=0.2
TURN_MAX_REQUEST_BYTES=65536
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_SOCKET_TIMEOUT_SECONDS=10

# Authenticated encryption key is created once for a new database; keep a
# separate secure backup. Never commit/copy it into an image or print it.
PRIVACY_KEY_FILE=data/privacy.key
# Engineering defaults, not a legal/clinical retention determination.
# retention CLI previews by default; --apply --offline is explicit erasure.
PRIVACY_TRACE_RETENTION_DAYS=30
PRIVACY_CONTENT_RETENTION_DAYS=90
PRIVACY_ACCESS_AUDIT_RETENTION_DAYS=365
