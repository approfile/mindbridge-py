    "environmentContract": {
      "type": "object",
      "properties": {
        "syntheticOnly": {
          "const": true
        },
        "isolatedDatabaseRequired": {
          "const": true
        },
        "isolatedRedisNamespaceRequired": {
          "const": true
        },
        "isolatedChromaRequired": {
          "const": true
        },
        "isolatedPrivacyKeyRequired": {
          "const": true
        },
        "freshStatePerTrial": {
          "const": true
        },
        "emailSink": {
          "type": "string",
          "minLength": 1
        },
        "realRecipientDeliveryForbidden": {
          "const": true
        },
        "knowledgeCorpus": {
          "type": "string",
          "minLength": 1
        },
        "networkPolicy": {
          "type": "string",
          "minLength": 1
        },
        "initialStateSemantics": {
          "type": "string",
          "minLength": 1
        },
        "jobSemantics": {
          "type": "string",
          "minLength": 1
        },
        "timeSemantics": {
          "type": "string",
          "minLength": 1
        },
        "executionScopes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "syntheticOnly",
        "isolatedDatabaseRequired",
        "isolatedRedisNamespaceRequired",
        "isolatedChromaRequired",
        "isolatedPrivacyKeyRequired",
        "freshStatePerTrial",
        "emailSink",
        "realRecipientDeliveryForbidden",
        "knowledgeCorpus",
        "networkPolicy",
        "initialStateSemantics",
        "jobSemantics",
        "timeSemantics",
        "executionScopes"
      ],
      "additionalProperties": false
    },
    "hardConstraintCatalog": {
      "type": "object",
      "properties": {
        "scope_ownership": {
          "type": "string",
          "minLength": 1
        },
        "authorized_effects_only": {
          "type": "string",
          "minLength": 1
        },
        "no_unreviewed_candidate": {
          "type": "string",
          "minLength": 1
        },
        "no_fabricated_completion": {
          "type": "string",
          "minLength": 1
        },
        "current_turn_bindings": {
          "type": "string",
          "minLength": 1
        },
        "reply_safety_boundaries": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scope_ownership",
        "authorized_effects_only",
        "no_unreviewed_candidate",
        "no_fabricated_completion",
        "current_turn_bindings",
        "reply_safety_boundaries"
      ],
      "additionalProperties": false
    },
    "gradingContract": {
      "type": "object",
      "properties": {
        "implementationStatus": {
          "const": "not_implemented_step_1_only"
        },
        "contractPass": {
          "type": "string",
          "minLength": 1
        },
        "goalAndHandlingSeparated": {
          "const": true
        },
        "safeFallbackIsFullCompletion": {
          "const": false
        },
        "boundaryRejection": {
          "type": "string",
          "minLength": 1
        },
        "faultNotTriggered": {
          "type": "string",
          "minLength": 1
        },
        "qualityJudge": {
          "type": "string",
          "minLength": 1
        },
        "noNativeToolClaim": {
          "type": "string",
          "minLength": 1
        },
        "repeatUnit": {
          "type": "string",
          "minLength": 1
        }
