    "failureTaxonomy": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(normal|high-risk|memory|evidence|recovery|boundary)-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "normal",
              "high-risk",
              "memory",
              "evidence",
              "recovery",
              "boundary"
            ]
          },
          "split": {
            "enum": [
              "development",
              "holdout"
            ]
          },
          "familyId": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "executionScope": {
            "enum": [
              "conversation",
              "tool_boundary",
              "http_boundary",
              "plan_boundary"
            ]
          },
          "eligibleModes": {
            "type": "array",
            "items": {
              "enum": [
                "configured_model",
                "controlled_model",
                "boundary_controlled"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "annotationStatus": {
            "const": "synthetic_contract_pending_independent_review"
          },
          "initialState": {
            "type": "object",
            "properties": {
              "actorAliases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "sessions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "alias": {
                      "type": "string",
                      "minLength": 1
                    },
                    "owner": {
                      "type": "string",
                      "minLength": 1
                    },
                    "history": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "role": {
                            "enum": [
                              "user",
                              "assistant"
                            ]
                          },
                          "content": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "role",
                          "content"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 0
                    },
                    "previousRisk": {
                      "enum": [
                        null,
                        "LOW",
                        "MEDIUM",
                        "HIGH"
                      ]
                    }
                  },
                  "required": [
                    "alias",
                    "owner",
                    "history",
                    "previousRisk"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "reports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "alias": {
                      "type": "string",
                      "minLength": 1
                    },
                    "session": {
                      "type": "string",
                      "minLength": 1
                    },
                    "risk": {
                      "enum": [
                        "LOW",
                        "MEDIUM",
                        "HIGH"
                      ]
                    },
                    "caseStatus": {
                      "enum": [
                        "OPEN",
                        "ALERT_SENT",
                        "ACKNOWLEDGED",
                        null
                      ]
                    }
                  },
                  "required": [
                    "alias",
                    "session",
                    "risk",
                    "caseStatus"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "jobs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "alias": {
                      "type": "string",
                      "minLength": 1
                    },
                    "report": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "enum": [
                        "EXCEL_REPORT",
                        "CASE_CREATE",
                        "ALERT_SEND",
                        "CASE_ACK",
                        "CASE_NOTE_ADD",
                        "RISK_ALERT"
                      ]
                    },
                    "state": {
                      "enum": [
                        "PENDING",
                        "RUNNING",
                        "SUCCESS",
                        "DEAD"
                      ]
                    },
                    "claimToken": {
                      "type": "string",
                      "minLength": 1
                    },
                    "lease": {
                      "enum": [
                        "future",
                        "expired"
                      ]
                    }
                  },
                  "required": [
                    "alias",
                    "report",
                    "kind",
                    "state",
                    "claimToken",
                    "lease"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              }
            },
            "required": [
              "actorAliases",
              "sessions",
              "reports",
              "jobs"
            ],
            "additionalProperties": false
          },
          "turns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "actor": {
                  "type": "string",
                  "minLength": 1
                },
                "session": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {
                  "type": "string",
                  "minLength": 1
                },
                "expected": {
                  "type": "object",
                  "properties": {
                    "acceptedIntents": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "CHAT",
                          "CONSULT",
                          "RISK"
                        ]
                      },
                      "minItems": 0,
                      "uniqueItems": true
                    },
                    "acceptedRisks": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "LOW",
                          "MEDIUM",
                          "HIGH"
                        ]
                      },
                      "minItems": 0,
                      "uniqueItems": true
                    },
                    "reportPolicy": {
                      "enum": [
                        "required",
                        "forbidden",
                        "if_consult_or_risk",
                        "not_created_before_abort"
                      ]
                    },
                    "requiredTools": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "enum": [
                              "EXCEL_REPORT",
                              "CASE_CREATE",
                              "ALERT_SEND",
                              "CASE_ACK",
                              "CASE_NOTE_ADD",
                              "RISK_ALERT"
                            ]
                          },
                          "when": {
                            "const": "report_created"
                          },
                          "terminalState": {
                            "enum": [
                              "SUCCESS",
                              "DEAD"
                            ]
                          }
                        },
                        "required": [
                          "kind",
                          "when",
                          "terminalState"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 0
                    },
                    "forbiddenTools": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "EXCEL_REPORT",
                          "CASE_CREATE",
                          "ALERT_SEND",
                          "CASE_ACK",
                          "CASE_NOTE_ADD",
                          "RISK_ALERT"
                        ]
                      },
                      "minItems": 0,
                      "uniqueItems": true
                    },
                    "replyMode": {
                      "enum": [
                        "reviewed_reply",
                        "safe_fallback",
                        "reviewed_reply_or_safe_fallback",
                        "no_reply_after_disconnect",
                        "access_error"
                      ]
                    },
                    "candidateReviewRequiredBeforeExposure": {
                      "const": true
                    },
                    "donePolicy": {
                      "enum": [
                        "required",
                        "forbidden",
                        "conditional_on_review_acceptance"
                      ]
                    }
                  },
                  "required": [
                    "acceptedIntents",
                    "acceptedRisks",
                    "reportPolicy",
                    "requiredTools",
                    "forbiddenTools",
                    "replyMode",
                    "candidateReviewRequiredBeforeExposure",
                    "donePolicy"
                  ],
                  "additionalProperties": false
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "actor",
                "session",
                "input",
                "expected",
                "id"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "boundaryActions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "call_tool",
                    "http_request",
                    "validate_plan_fixture"
                  ]
                },
                "actor": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "arguments": {
                  "type": "object"
                }
              },
              "required": [
                "id",
                "kind",
                "actor",
                "target",
                "arguments"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
