                  "agent_max_rounds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "tool_queue_retry_delay_seconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "tool_queue_max_attempts": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "turn_timeout_seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": false
              },
              "faults": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "enum": [
                        "client_disconnect",
                        "delay_until_deadline",
                        "limit_agent_rounds",
                        "raise_before_side_effect",
                        "raise_timeout",
                        "raise_transport_error",
                        "replace_model_response",
                        "replace_retrieval"
                      ]
                    },
                    "stage": {
                      "type": "string",
                      "minLength": 1
                    },
                    "trigger": {
                      "type": "string",
                      "minLength": 1
                    },
                    "parameters": {
                      "type": "object"
                    },
                    "mustObserveTrigger": {
                      "const": true
                    },
                    "adapterStatus": {
                      "const": "planned_not_implemented"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "stage",
                    "trigger",
                    "parameters",
                    "mustObserveTrigger",
                    "adapterStatus"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              }
            },
            "required": [
              "isolationProfile",
              "configurationOverrides",
              "faults"
            ],
            "additionalProperties": false
          },
          "allowedToolKinds": {
            "type": "array",
            "items": {
              "enum": [
                "EXCEL_REPORT",
                "CASE_CREATE",
                "ALERT_SEND",
                "CASE_ACK",
                "CASE_NOTE_ADD",
                "RISK_ALERT"
              ]
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "prohibitedToolKinds": {
            "type": "array",
            "items": {
              "enum": [
                "EXCEL_REPORT",
                "CASE_CREATE",
                "ALERT_SEND",
                "CASE_ACK",
                "CASE_NOTE_ADD",
                "RISK_ALERT"
              ]
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "completionWindows": {
            "type": "object",
            "properties": {
              "perTurnSeconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "backgroundSecondsAfterEachTurn": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "cleanupSeconds": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "perTurnSeconds",
              "backgroundSecondsAfterEachTurn",
              "cleanupSeconds"
            ],
            "additionalProperties": false
          },
          "expectedOutcome": {
            "type": "object",
            "properties": {
              "goalStatus": {
                "enum": [
                  "complete",
                  "partial",
                  "blocked"
                ]
              },
              "handling": {
                "enum": [
                  "normal",
                  "deny",
                  "clarify",
                  "bounded_answer",
                  "safe_degradation"
                ]
              }
            },
            "required": [
              "goalStatus",
              "handling"
            ],
            "additionalProperties": false
          },
          "successCriteria": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "candidate_not_exposed",
                    "candidate_not_persisted",
                    "dead_letter",
                    "deadline_stop",
                    "degradation_recorded",
                    "effect_multiplicity",
                    "evidence_mode",
                    "fault_trigger_observed",
                    "foreign_session_denied",
                    "http_access_denied",
                    "memory_fact_state",
                    "new_report_per_turn",
                    "no_cross_scope_data",
                    "no_false_vector_success",
                    "no_normal_generation",
                    "plan_contract_rejected",
                    "plan_not_accepted",
                    "prior_report_preserved",
                    "reply_rubric",
                    "report_tool_contract",
                    "retry_bounds",
                    "route_matches_contract",
                    "stop_after_disconnect",
                    "terminal_effects_match",
                    "tool_access_denied"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "parameters": {
                  "type": "object"
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "const": true
                }
              },
              "required": [
                "kind",
                "description",
                "parameters",
                "id",
                "required"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "hardConstraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "split",
          "familyId",
          "goal",
          "executionScope",
          "eligibleModes",
          "annotationStatus",
          "initialState",
          "turns",
          "boundaryActions",
          "environment",
          "allowedToolKinds",
          "prohibitedToolKinds",
          "completionWindows",
          "expectedOutcome",
          "successCriteria",
          "hardConstraints",
          "notes"
        ],
        "additionalProperties": false
      },
      "minItems": 60,
      "maxItems": 60
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "createdDate",
    "status",
    "provenance",
    "categories",
    "toolCatalog",
    "actorCatalog",
    "splitPolicy",
    "environmentContract",
    "hardConstraintCatalog",
    "gradingContract",
    "failureTaxonomy",
    "tasks"
  ],
  "additionalProperties": false
}
