      "required": [
        "implementationStatus",
        "contractPass",
        "goalAndHandlingSeparated",
        "safeFallbackIsFullCompletion",
        "boundaryRejection",
        "faultNotTriggered",
        "qualityJudge",
        "noNativeToolClaim",
        "repeatUnit"
      ],
      "additionalProperties": false
