      "properties": {
        "normal": {
          "type": "string",
          "minLength": 1
        },
        "high-risk": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "recovery": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "normal",
        "high-risk",
        "memory",
        "evidence",
        "recovery",
        "boundary"
      ],
      "additionalProperties": false
    },
    "toolCatalog": {
      "const": [
        "EXCEL_REPORT",
        "CASE_CREATE",
        "ALERT_SEND",
        "CASE_ACK",
        "CASE_NOTE_ADD",
        "RISK_ALERT"
      ]
    },
