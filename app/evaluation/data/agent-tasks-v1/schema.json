          "required": [
            "roles"
          ],
          "additionalProperties": false
        },
        "student_b": {
          "type": "object",
          "properties": {
            "roles": {
              "const": [
                "ROLE_USER"
              ]
            }
          },
          "required": [
            "roles"
          ],
          "additionalProperties": false
        },
        "admin_plain": {
          "type": "object",
          "properties": {
            "roles": {
              "const": [
                "ROLE_USER",
                "ROLE_ADMIN"
              ]
            }
