{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline Agent observation v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "trialId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "configured_model",
        "controlled_model",
        "boundary_controlled"
      ]
    },
    "datasetSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "producer": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "evaluation_collector",
            "synthetic_fixture"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "fixtureStatus": {
      "enum": [
        "verified",
        "invalid",
        "unknown"
      ]
    },
    "bindings": {
      "type": "object",
      "properties": {
        "actors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "sessions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "ownerId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "ownerId"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "actors",
        "sessions"
      ],
      "additionalProperties": false
    },
    "faults": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "trigger": {
                "type": "string",
                "minLength": 1
              },
              "triggered": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "stage",
              "trigger",
              "triggered"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "turnId": {
            "type": "string",
            "minLength": 1
          },
          "actorAlias": {
            "type": "string",
            "minLength": 1
          },
          "sessionAlias": {
            "type": "string",
            "minLength": 1
          },
          "runId": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "complete",
                "partial",
                "unavailable"
              ]
            }
          },
          "route": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "intent": {
                    "enum": [
                      null,
                      "CHAT",
                      "CONSULT",
                      "RISK"
                    ]
                  },
                  "risk": {
                    "enum": [
                      null,
                      "LOW",
                      "MEDIUM",
                      "HIGH"
                    ]
                  }
                },
                "required": [
                  "intent",
                  "risk"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "reports": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "userId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sessionId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "risk": {
                      "enum": [
                        "LOW",
                        "MEDIUM",
                        "HIGH"
                      ]
                    },
                    "intent": {
                      "enum": [
                        "CHAT",
                        "CONSULT",
                        "RISK"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "userId",
                    "sessionId",
                    "risk",
                    "intent"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "jobs": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reportId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "state": {
                      "enum": [
                        "PENDING",
                        "RUNNING",
                        "SUCCESS",
                        "DEAD"
                      ]
                    },
                    "attempts": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "maxAttempts": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "runId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "reportId",
                    "kind",
                    "state",
                    "attempts",
                    "maxAttempts",
                    "runId"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "effects": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reportId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "kind",
                    "reportId",
                    "source",
                    "count"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "audits": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "jobId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reportId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "allowed": {
                      "type": "boolean"
                    },
                    "status": {
                      "enum": [
                        "AUTHORIZED",
                        "SUCCESS",
                        "FAILED",
                        "BLOCKED",
                        "INTERRUPTED"
                      ]
                    },
                    "runId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "jobId",
                    "reportId",
                    "kind",
                    "allowed",
                    "status",
                    "runId"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "events": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "seq": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "kind": {
                      "enum": [
                        "RISK_ASSESSED",
                        "PLAN_ACCEPTED",
                        "GENERATION_STARTED",
                        "BODY_REVIEW",
                        "SSE_TOKEN",
                        "SSE_DONE",
                        "SSE_ERROR",
                        "CLIENT_DISCONNECTED",
                        "TURN_TIMEOUT"
                      ]
                    },
                    "runId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "candidateSha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "approved": {
                      "type": "boolean"
                    },
                    "source": {
                      "enum": [
                        "model_candidate",
                        "fixed_template"
                      ]
                    }
                  },
                  "required": [
                    "seq",
                    "kind",
                    "runId"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "invocations": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "seq": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "completedSeq": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "jobId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "argumentsDigest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "origin": {
                      "enum": [
                        "workflow",
                        "probe"
                      ]
                    },
                    "outcome": {
                      "enum": [
                        "SUCCESS",
                        "FAILED",
                        "UNKNOWN"
                      ]
                    }
                  },
                  "required": [
                    "seq",
                    "jobId",
                    "kind",
                    "argumentsDigest",
                    "origin",
                    "outcome"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "reply": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "enum": [
                      "reviewed_reply",
                      "safe_fallback",
                      "error",
                      "none",
                      "access_error"
                    ]
                  },
                  "sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "persistedAccepted": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "mode",
                  "sha256",
                  "persistedAccepted"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "planChecks": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "backgroundWindowClosed": {
            "type": "boolean"
          },
          "timings": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "turnMs": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "firstReviewedTextMs": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "backgroundMs": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "turnMs",
                  "firstReviewedTextMs",
                  "backgroundMs"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "usage": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "logicalModelCalls": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "apiAttempts": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "embeddingRequests": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "providerTokens": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "source": {
                            "const": "provider_usage"
                          },
                          "complete": {
                            "type": "boolean"
                          },
                          "prompt": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "completion": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "total": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "source",
                          "complete",
                          "prompt",
                          "completion",
                          "total"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "cost": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "amount": {
                            "type": "number",
                            "minimum": 0
                          },
                          "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$"
                          },
                          "pricingVersion": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "amount",
                          "currency",
                          "pricingVersion"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "logicalModelCalls",
                  "apiAttempts",
                  "embeddingRequests",
                  "providerTokens",
                  "cost"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "memory": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "type": "object"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "context": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "degradations": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "deadLetters": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "turnId",
          "actorAlias",
          "sessionAlias",
          "runId",
          "coverage"
        ],
        "additionalProperties": false
      }
    },
    "boundaryResults": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actionId": {
                "type": "string",
                "minLength": 1
              },
              "denied": {
                "type": "boolean"
              },
              "sideEffectCount": {
                "type": "integer",
                "minimum": 0
              },
              "httpStatus": {
                "type": "integer",
                "minimum": 0
              },
              "auditFound": {
                "type": "boolean"
              },
              "planAccepted": {
                "type": "boolean"
              }
            },
            "required": [
              "actionId",
              "denied",
              "sideEffectCount"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkId": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "graderKind": {
            "enum": [
              "human",
              "independent_model",
              "external_assertion",
              "runtime_gate"
            ]
          },
          "graderId": {
            "type": "string",
            "minLength": 1
          },
          "graderVersion": {
            "type": "string",
            "minLength": 1
          },
          "subjectDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "checkId",
          "verdict",
          "graderKind",
          "graderId",
          "graderVersion",
          "subjectDigest",
          "evidenceRefs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "taskId",
    "trialId",
    "mode",
    "datasetSha256",
    "producer",
    "fixtureStatus",
    "bindings",
    "faults",
    "turns",
    "boundaryResults",
    "reviews"
  ],
  "additionalProperties": false
}
