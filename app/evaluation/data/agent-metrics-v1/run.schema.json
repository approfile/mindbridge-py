{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "trialId": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "configured_model",
              "controlled_model",
              "boundary_controlled"
            ]
          },
          "source": {
            "enum": [
              "evaluation_collector",
              "synthetic_fixture"
            ]
          }
        },
        "required": [
          "taskId",
          "trialId",
          "mode",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "taskId",
          "trialId"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "runPlan",
    "observations"
  ],
  "additionalProperties": false
}
